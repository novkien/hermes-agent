# Copy selected values to ~/.hermes/mission-control.env on the Hermes host.
# Never commit the populated runtime file.

# Public/LAN bind requires an explicit allowlist.
BIND_HOST=0.0.0.0
MISSION_CONTROL_PORT=51763
ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10
ALLOWED_ORIGIN=http://192.168.1.128:51763
ALLOWED_HOST=192.168.1.128:51763

# Native Hermes APIs on the same host.
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_GATEWAY_URL=http://127.0.0.1:8642

# Transitional external adapter. Remove after its separately authorized merge.
ADAPTER_URL=http://127.0.0.1:8643
SYSTEM_MANAGER_URL=http://127.0.0.1:8787

# Repository control. The dashboard/cron share one deterministic CLI.
# The two remote repositories are reached from the Hermes host over SSH.
REPO_SYNC_REMOTE_SSH=jarvis@192.168.1.140
# Optional exact-path overrides. If omitted, the repository engine only probes its
# bounded built-in candidate paths and reports repo_not_found instead of creating or
# guessing a checkout.
# REPO_SYNC_HERMES_AGENT_PATH=/path/to/novkien/hermes-agent
# REPO_SYNC_HERMES_PLUGINS_PATH=/path/to/novkien/hermes-plugins
# REPO_SYNC_AGENTS_PATH=/path/to/novkien/agents
# REPO_SYNC_9ROUTER_PATH=/path/to/novkien/9router
# REPO_SYNC_LLAMA_PROXY_PATH=/path/to/novkien/llama-proxy
# REPO_SYNC_HERMES_SKILLS_GIT_DIR=/home/jarvis/.hermes/repos/hermes-skills.git
# REPO_SYNC_HERMES_SKILLS_WORK_TREE=/home/jarvis/.hermes
# REPO_SYNC_STATE_DIR=/home/jarvis/.hermes/mission-control/repository-sync

# GitHub API token used only for private-repo PR visibility/mutations and fork sync.
# Grant only the repository permissions needed for Contents/Pull Requests.
# AGENTOS_GITHUB_TOKEN=...

# Secret values belong only in the deployed environment file.
# DASHBOARD_BASIC_AUTH_PASSWORD=...
# HERMES_GATEWAY_API_KEY=...
# ADAPTER_TOKEN=...
# NAS_JWT_SECRET=...
