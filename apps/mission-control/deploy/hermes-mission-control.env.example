# Copy selected values to ~/.hermes/mission-control.env on the Hermes host.
# Never commit the populated runtime file.

# Public/LAN bind requires an explicit allowlist.
BIND_HOST=0.0.0.0
MISSION_CONTROL_PORT=51763
ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10
ALLOWED_ORIGIN=http://192.168.1.128:51763
ALLOWED_HOST=192.168.1.128:51763

# Native Hermes APIs on the same host.
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_GATEWAY_URL=http://127.0.0.1:8642

# Transitional external adapter. Remove after its separately authorized merge.
ADAPTER_URL=http://127.0.0.1:8643
SYSTEM_MANAGER_URL=http://127.0.0.1:8787

# Secret values belong only in the deployed environment file.
# DASHBOARD_BASIC_AUTH_PASSWORD=...
# HERMES_GATEWAY_API_KEY=...
# ADAPTER_TOKEN=...
# NAS_JWT_SECRET=...
